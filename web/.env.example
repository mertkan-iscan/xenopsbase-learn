# Copy to .env.local. Development values only.
#
# Normally EMPTY: the browser talks to one origin, and the dev server proxies /api to the
# services (see vite.config.ts). Set this only to point a build at a service directly, which
# means opening CORS on that service.
VITE_IDENTITY_URL=

# A token from `make token U=acme-admin`, pasted. DEVELOPMENT ONLY -- real sign-in is T-10.2,
# where the gateway holds the session and this application never sees a credential.
VITE_DEV_TOKEN=
