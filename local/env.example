# The credentials this project needs, as a template with no values in it.
#
# COPY THIS TO ~/.xenopsbase-learn.env AND FILL IT IN THERE. Not here, not
# anywhere under this repository.
#
#     cp local/env.example ~/.xenopsbase-learn.env
#     $EDITOR ~/.xenopsbase-learn.env
#     source ~/.xenopsbase-learn.env      # once per terminal
#
# WHY OUTSIDE THE REPOSITORY, when .gitignore already lists .env.
#
# Because .gitignore is a rule somebody can defeat without meaning to. `git add
# -f`, a rename to `.env.local` that no pattern covers, a tool that writes
# `env.backup`, an editor's swap file -- and several agents work in this
# checkout at once, any of which might reasonably run `git add -A`. A secret
# outside the working tree cannot be committed by accident, and that is a
# property of WHERE it lives rather than of anybody remembering. This mirrors
# ~/.xenopsbase.env, which the stemcell uses for the same reason.
#
# NOTHING SOURCES THIS FOR YOU, deliberately. `make` guards on the variables
# instead of reading the file itself, so `make` and your shell can never
# disagree about what is set -- a credential that exists only inside make is one
# you cannot reproduce by hand when something breaks.
#
# The local stack needs NONE of this. `make up` and `make run` work with an
# empty environment; everything below is for talking to something real.

# -----------------------------------------------------------------------------
# Cloudflare Stream (T-9.14). Nothing here is read unless MEDIA_PROVIDER says so.
# -----------------------------------------------------------------------------

# `fake` (the default) or `cloudflare-stream`. Leave it unset for local work:
# the fake provider is what makes a stack without a vendor account a working
# stack, and it warns at startup so a green run is never mistaken for evidence
# about the edge.
export MEDIA_PROVIDER=

# Not a secret; it is in every API URL.
export CF_STREAM_ACCOUNT_ID=

# Scope it to Account > Stream > Edit and NOTHING else. Prove it with
# `bash scripts/cloudflare-check.sh` rather than by reading the permissions
# page -- Stream:Read where Edit was meant passes every GET you try by hand.
export CF_STREAM_API_TOKEN=

# The delivery host, minus the `customer-` prefix and the domain. Derived for
# you by cloudflare-check.sh, because a wrong value fails only at playback.
export CF_STREAM_CUSTOMER_SUBDOMAIN=

# THE SHARPEST CREDENTIAL IN THIS FILE. Playback tokens are signed with the JWK
# locally, with no network call (ADR-0101), so nothing at Cloudflare's end can
# observe or revoke a token minted by whoever holds a copy. It is returned ONLY
# at key creation and is stored nowhere else, ever.
export CF_STREAM_SIGNING_KEY_ID=
export CF_STREAM_SIGNING_KEY_JWK=

# Blank means no inbound encode notification is trusted (T-3.3), which is safe:
# the reconciler polls, so a deployment without this is slower, not broken.
export CF_STREAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Keycloak realm administration (T-1.8). Only needed to apply a customer's
# identity provider for real; without it providers are recorded and reported as
# unapplied rather than silently pretending.
# -----------------------------------------------------------------------------

# The service account these name needs manage-identity-providers and NOT
# realm-admin: this service has no business editing users in the realm.
export REALM_ADMIN_URL=
export REALM_ADMIN_REALM=
export REALM_ADMIN_CLIENT_ID=
export REALM_ADMIN_CLIENT_SECRET=

# `dns` everywhere real. The local stack sets `trusting` in application.yml
# because acme.test can never publish a DNS record; setting it here would apply
# it to whatever you point this shell at, which is the wrong blast radius.
export SSO_DOMAIN_VERIFICATION=

# -----------------------------------------------------------------------------
# Service-to-service (T-9.11). Per service and rotatable on its own -- a shared
# secret would make rotating any of them an outage for all of them, and would
# let any service claim to be another. The local defaults in application.yml are
# development-only strings and say so.
# -----------------------------------------------------------------------------
export SERVICE_CLIENT_ID=
export SERVICE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Where things are, when they are not on localhost.
# -----------------------------------------------------------------------------
export OIDC_ISSUER_URI=
export IDENTITY_URL=
export STREAMING_URL=
export REPORTING_URL=
export VALKEY_HOST=
export VALKEY_PORT=
export VALKEY_PASSWORD=
