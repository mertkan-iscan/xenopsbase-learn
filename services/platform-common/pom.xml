<?xml version="1.0" encoding="UTF-8"?>
<!--
    What every PROCESS shares, whatever web stack it runs (ADR-0111).

    NOT a place for domain code — nothing in here may know what a course, a
    video or an attempt is. And, since ADR-0111, not a place for a servlet
    either: this module compiles without jakarta.servlet on the classpath and
    an ArchUnit rule in its own test source keeps it that way.

    THE REASON THE LINE IS DRAWN HERE, because it is not obvious and it cost a
    review to find. Eight of our nine processes are Spring MVC on virtual
    threads. The ninth — `gateway` — is Spring Cloud Gateway, which exists only
    on WebFlux and cannot be anything else. A library that pulls
    spring-boot-starter-web brings Tomcat, Boot then resolves the application
    type as SERVLET, and the gateway does not start. So a single shared library
    would have had exactly two possible endings: the gateway depends on nothing
    of ours and re-declares the tenant key, the correlation header and the
    status enum itself, or the gateway does not start.

    Both endings are worse than a second module. The second is a build failure
    somebody fixes in an hour; the first is `status:tenant:` written down in two
    repositories' worth of places, drifting apart silently — which is the exact
    failure PublishedStatusLookup's own javadoc was written to describe.

    So: this module holds the CONTRACT and everything that does not touch a
    request — the tenant key, the correlation header, the status enum, the
    outbox, the bus, mail. `platform-common-web` holds the servlet half, and
    every MVC service depends on that and gets this transitively.

    The test for whether something belongs here is unchanged, with one clause
    added: would all nine processes otherwise write it identically, AND can it
    be written without naming a servlet request?
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xenopsoftware.learn</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>platform-common</artifactId>
    <name>Platform common</name>
    <description>Web-stack-neutral shared code: the contract every process agrees on</description>

    <dependencies>
        <!--
            `starter`, deliberately NOT `starter-web`. This is the single line
            that makes the gateway able to depend on this module, and changing
            it back is how the split silently stops working: adding starter-web
            here would not fail any test in this module, it would fail the
            gateway's startup on a cluster. PlatformCommonIsStackNeutralTest is
            what turns that into a build failure instead.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Meters for the outbox (T-9.8). The registry itself arrives with
            whichever actuator starter the including process brings; this is
            the API the code compiles against, and it carries no web stack.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!--
            Optional, deliberately: TenantOwned and TenantIdentifierResolver
            exist for the modules that persist tenant-scoped data, and a
            process without JPA — the gateway is the live example, not a
            hypothetical one any more — must not inherit Hibernate by
            depending on this library. Optional means each JPA service brings
            its own persistence starter and these two classes simply resolve.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            JDBC, for the outbox (T-9.8). Optional like the rest of the
            persistence story here: the outbox writer and relay work against
            whatever DataSource the including service already has, and a service
            with no database must not inherit one by depending on this library.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            The message bus (T-9.8). Optional for the same reason Hibernate is:
            a service that neither publishes nor consumes must not inherit a
            broker client by depending on this library. Each service that joins
            the bus brings it, and the messaging beans are conditional on it
            being there.
        -->
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Mail (T-5.6, and what T-7.9 will need). Optional on the same rule:
            a service that sends nothing must not inherit a mail client. Where
            it is absent, or present and unconfigured, MailConfiguration wires
            LoggingMailer instead: it delivers nothing and says so, rather than
            failing at startup or pretending.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                THE RULE THE SPLIT RESTS ON, ENFORCED WHERE IT CAN ACTUALLY BE
                BROKEN (ADR-0111).

                An ArchUnit rule catches servlet code written in this module.
                It does NOT catch the thing that actually breaks the gateway,
                which is a servlet JAR arriving on this module's classpath
                without a line of code referencing it: Boot resolves the
                application type by looking for classes, so Tomcat's mere
                PRESENCE flips the gateway from reactive to servlet and Spring
                Cloud Gateway refuses to start. Nothing here would have failed;
                a deployment would have.

                So the guard is on the dependency tree rather than on the
                source, it names the transitive case explicitly, and its
                message says where the servlet half lives so the fix is
                obvious rather than archaeological.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-web-stack</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-webmvc</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-webflux</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-tomcat</exclude>
                                        <exclude>org.springframework:spring-webmvc</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>org.springframework.security:spring-security-web</exclude>
                                        <exclude>org.apache.tomcat.embed:*</exclude>
                                        <exclude>jakarta.servlet:*</exclude>
                                    </excludes>
                                    <message>
                                        platform-common must stay free of any web stack: the gateway
                                        depends on it, and Spring Cloud Gateway does not start once a
                                        servlet container is on the classpath (ADR-0111). Whatever
                                        needed this belongs in platform-common-web, which every MVC
                                        service already depends on.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                A library, not an application. Without this, spring-boot:repackage
                turns the jar into an executable archive whose classes are under
                BOOT-INF/ and therefore invisible to anything depending on it —
                which presents as "cannot find symbol" for a class that is plainly
                in the jar.
            -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <!--
                        NOT AN IMAGE. This module is a library every service
                        depends on; it has no main class and nothing to run.

                        Skipped explicitly rather than left unconfigured
                        because `mvn jib:build` at the repository root runs the
                        goal against every module in the reactor, and the
                        failure it produces there names a missing mainClass,
                        which reads as "the plugin is misconfigured" rather
                        than "this module is a library". Saying so here makes
                        a root level build do the right thing (T-9.3).
                    -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
