<?xml version="1.0" encoding="UTF-8"?>
<!--
    What every service shares. NOT a place for domain code — nothing in here
    may know what a course, a video or an attempt is.

    The test for whether something belongs here is whether all six modules would
    otherwise write it identically: the error shape, the request id, how the
    tenant is resolved from a token. A helper two modules happen to want is not
    shared infrastructure, it is a copy waiting to diverge in a place nobody
    looks.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xenopsoftware.learn</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>platform-common</artifactId>
    <name>Platform common</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Optional, deliberately: TenantOwned and TenantIdentifierResolver
            exist for the modules that persist tenant-scoped data, and a
            service without JPA (the gateway) must not inherit Hibernate by
            depending on this library. Optional means each JPA service brings
            its own persistence starter and these two classes simply resolve.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Optional, like Hibernate above and for the same reason: the shared
            status lookup (T-1.4) reads Valkey, but a service that does not
            need the fast path must not inherit a Redis client by depending on
            this library. Optional means each service that wants it brings its
            own starter, and the lookup simply resolves.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                A library, not an application. Without this, spring-boot:repackage
                turns the jar into an executable archive whose classes are under
                BOOT-INF/ and therefore invisible to anything depending on it —
                which presents as "cannot find symbol" for a class that is plainly
                in the jar.
            -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <!--
                        NOT AN IMAGE. This module is a library every service
                        depends on; it has no main class and nothing to run.

                        Skipped explicitly rather than left unconfigured
                        because `mvn jib:build` at the repository root runs the
                        goal against every module in the reactor, and the
                        failure it produces there names a missing mainClass,
                        which reads as "the plugin is misconfigured" rather
                        than "this module is a library". Saying so here makes
                        a root level build do the right thing (T-9.3).
                    -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
